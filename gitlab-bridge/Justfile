# SPDX-License-Identifier: MPL-2.0
# Claude GitLab Bridge — build automation
#
# Stack: AffineScript (sources) + Deno (runtime + task runner). All recipes
# delegate to `deno task <name>` (see deno.json) or `affinescript ...`.
# No npm / Node — see hyperpolymath language policy.

# Default — list all recipes.
default:
    @just --list

# === Development ===

# Build AffineScript sources (emits *.res.js next to *.res, in-source).
build:
    affinescript build

# Watch + run dev server (deno task dev → src/Main.res.js).
dev:
    deno task dev

# Clean AffineScript build artefacts.
clean:
    affinescript clean

# Full clean.
clean-all: clean
    rm -rf coverage/

# === Testing ===

# Run all tests (Deno test runner over compiled *.res.js).
test:
    deno task test

# Run tests in watch mode.
test-watch:
    deno task test:watch

# Generate coverage report.
test-coverage:
    deno task test:coverage
    @echo "Coverage report: coverage/"

# === Quality ===

# Lint sources (Deno's built-in linter).
lint:
    deno task lint

# Format sources.
format:
    deno task fmt

# Check formatting (CI mode — no rewrite).
format-check:
    deno fmt --check src/ tests/

# Type-check the compiled output.
check:
    deno task check

# === Verification ===

# Comprehensive RSR GOLD validation (build + test + RSR file presence).
validate: format-check lint check test
    @echo ""
    @echo "=== RSR GOLD Compliance Validation ==="
    @echo ""
    @echo "Checking SPDX header on CLAUDE.md..."
    @if ! grep -q "SPDX-License-Identifier" CLAUDE.md; then \
        echo "❌ Missing SPDX header in CLAUDE.md"; \
        exit 1; \
    fi
    @echo "✓ CLAUDE.md has SPDX header"
    @echo ""
    @echo "Checking required files..."
    @test -f LICENSE.txt || (echo "❌ Missing LICENSE.txt" && exit 1)
    @test -f GOVERNANCE.adoc || (echo "❌ Missing GOVERNANCE.adoc" && exit 1)
    @test -f REVERSIBILITY.md || (echo "❌ Missing REVERSIBILITY.md" && exit 1)
    @test -f .gitattributes || (echo "❌ Missing .gitattributes" && exit 1)
    @test -f .well-known/security.txt || (echo "❌ Missing .well-known/security.txt" && exit 1)
    @test -f .well-known/ai.txt || (echo "❌ Missing .well-known/ai.txt" && exit 1)
    @test -f .well-known/humans.txt || (echo "❌ Missing .well-known/humans.txt" && exit 1)
    @test -f .well-known/consent-required.txt || (echo "❌ Missing .well-known/consent-required.txt" && exit 1)
    @test -f .well-known/provenance.json || (echo "❌ Missing .well-known/provenance.json" && exit 1)
    @test -f CODE_OF_CONDUCT.adoc || (echo "❌ Missing CODE_OF_CONDUCT.adoc" && exit 1)
    @test -f CONTRIBUTING.adoc || (echo "❌ Missing CONTRIBUTING.adoc" && exit 1)
    @echo "✓ All required RSR files present"
    @echo ""
    @echo "Checking npm/TS artefacts are absent..."
    @test ! -f package.json     || (echo "❌ package.json present (npm banned)" && exit 1)
    @test ! -f package-lock.json || (echo "❌ package-lock.json present (npm banned)" && exit 1)
    @test ! -f tsconfig.json    || (echo "❌ tsconfig.json present (TypeScript banned)" && exit 1)
    @test -z "$$(find src tests -name '*.ts' 2>/dev/null)" || (echo "❌ .ts files found (banned)" && exit 1)
    @echo "✓ No banned-language artefacts"
    @echo ""
    @echo "✓ RSR GOLD validation complete"

# Pre-commit checks.
pre-commit: format lint check
    @echo "✓ Pre-commit checks passed"

# Pre-release checks.
pre-release: clean build validate test-coverage
    @echo "✓ Ready for release"

# === Documentation ===

# Check documentation links.
docs-check:
    @echo "Checking documentation for broken links..."
    @grep -r "](.*)" *.md docs/*.md 2>/dev/null | grep -v "http" || echo "✓ No obvious broken internal links"

# Count documentation lines.
docs-stats:
    @echo "=== Documentation Statistics ==="
    @echo "Markdown files:"
    @find . -name "*.md" -exec wc -l {} + | tail -1
    @echo "AsciiDoc files:"
    @find . -name "*.adoc" -exec wc -l {} + | tail -1

# === Git ===

# Show git status.
status:
    git status

# Show recent commits.
log:
    git log --oneline -10

# Create new branch.
branch name:
    git checkout -b {{name}}

# === Release ===

# Bump version (patch) — edits affinescript.json (the canonical version source).
bump-patch:
    @echo "Current version: $(jq -r .version affinescript.json)"
    @new=$(jq -r '.version | split(".") | [.[0], .[1], (.[2] | tonumber + 1 | tostring)] | join(".")' affinescript.json) && \
        jq --arg v "$$new" '.version = $$v' affinescript.json > affinescript.json.tmp && mv affinescript.json.tmp affinescript.json && \
        echo "New version: $$new"

# Bump version (minor).
bump-minor:
    @echo "Current version: $(jq -r .version affinescript.json)"
    @new=$(jq -r '.version | split(".") | [.[0], (.[1] | tonumber + 1 | tostring), "0"] | join(".")' affinescript.json) && \
        jq --arg v "$$new" '.version = $$v' affinescript.json > affinescript.json.tmp && mv affinescript.json.tmp affinescript.json && \
        echo "New version: $$new"

# Bump version (major).
bump-major:
    @echo "Current version: $(jq -r .version affinescript.json)"
    @new=$(jq -r '.version | split(".") | [(.[0] | tonumber + 1 | tostring), "0", "0"] | join(".")' affinescript.json) && \
        jq --arg v "$$new" '.version = $$v' affinescript.json > affinescript.json.tmp && mv affinescript.json.tmp affinescript.json && \
        echo "New version: $$new"

# === Utilities ===

# Count lines of code.
loc:
    @echo "=== Lines of Code ==="
    @echo "AffineScript:"
    @find src -name "*.res" -exec wc -l {} + 2>/dev/null | tail -1 || echo "0"
    @echo "Tests:"
    @find tests -name "*.res" -exec wc -l {} + 2>/dev/null | tail -1 || echo "0"
    @echo "Documentation:"
    @find . -name "*.md" -o -name "*.adoc" -exec wc -l {} + 2>/dev/null | tail -1

# Show project statistics.
stats:
    @echo "=== Project Statistics ==="
    @echo "Total files: $(find . -type f ! -path './.git/*' | wc -l)"
    @echo "AffineScript files: $(find src -name '*.res' 2>/dev/null | wc -l)"
    @echo "Test files: $(find tests -name '*.res' 2>/dev/null | wc -l)"
    @echo "Documentation files: $(find . -name '*.md' -o -name '*.adoc' | wc -l)"
    @just loc

# Show help for specific recipe.
help recipe:
    @just --show {{recipe}}

# === Environment ===

# Create .env from example.
env-setup:
    @if [ ! -f .env ]; then \
        cp .env.example .env; \
        echo "✓ Created .env from .env.example"; \
        echo "⚠️  Please edit .env with your credentials"; \
    else \
        echo "⚠️  .env already exists"; \
    fi

# Validate .env file.
env-check:
    @if [ ! -f .env ]; then \
        echo "❌ .env file not found"; \
        echo "Run: just env-setup"; \
        exit 1; \
    fi
    @echo "✓ .env file exists"
    @echo "Checking required variables..."
    @grep -q "GITLAB_TOKEN" .env || (echo "❌ Missing GITLAB_TOKEN" && exit 1)
    @grep -q "ANTHROPIC_API_KEY" .env || (echo "❌ Missing ANTHROPIC_API_KEY" && exit 1)
    @echo "✓ Required environment variables present"

# === CI/CD ===

# Run CI checks.
ci: build lint check test
    @echo "✓ CI checks passed"

# Run full CI pipeline.
ci-full: ci test-coverage validate
    @echo "✓ Full CI pipeline passed"

secret-scan-trufflehog:
    @command -v trufflehog >/dev/null && trufflehog filesystem . --only-verified || true
